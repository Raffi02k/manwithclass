    "preview": "vite preview",
    "test:static": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.8.3",
    "vite": "7.3.1"
  }
}
